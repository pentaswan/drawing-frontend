# Default vision provider: perceptron | openai | anthropic | grok
VISION_PROVIDER=perceptron

# Perceptron (default) — https://platform.perceptron.inc
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic fallback (note spelling: ANTHROPIC, not ANTRHOPIC)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Grok / xAI — https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.7

# API server
PORT=3001

# Per-user backend sandboxes (child-process timeouts, ms)
SANDBOX_TIMEOUT_MS=12000
SANDBOX_INSTALL_TIMEOUT_MS=60000
